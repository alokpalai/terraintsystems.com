# Cache headers for Netlify / Cloudflare Pages (ignored by other hosts).
# CSS/JS are referenced with ?v=<hash>, so they can be cached for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=2592000
